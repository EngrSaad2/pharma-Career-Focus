<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical 301 (HTTP & WWW -> HTTPS non-www)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.pharmacareercompass\.com [NC]
    RewriteRule ^(.*)$ https://pharmacareercompass.com/$1 [L,R=301]

    # Block direct access to hidden/sensitive files
    RewriteRule ^\.(env|git|editorconfig|gitattributes) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js) - [F,L,NC]

    # Clean /index.php from URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php[\s\?/] [NC]
    RewriteRule ^index\.php(?:/(.*))?$ https://pharmacareercompass.com/$1 [R=301,L]

    # Clean /public/ from URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /public(?:/index\.php)?[\s\?/] [NC]
    RewriteRule ^public(?:/index\.php)?(?:/(.*))?$ https://pharmacareercompass.com/$1 [R=301,L]

    # Route all requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
